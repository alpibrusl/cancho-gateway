edition 5;

module gateway.out;

// Writing bytes into a caller's buffer at an offset: every function answers the new offset, or `0 - 1` if the bytes do not
// fit (nothing is written past the end, and a failed write leaves the offset's meaning to the caller: it abandons the
// buffer). The one place the gateway builds heads and error bodies.

pub fn put[&o, &s](out: &!o [byte], at: int, s: &s [byte]) -> [] int {
    if at < 0 || at + len(s) > len(out) {
        return 0 - 1;
    }
    var i = 0;
    while i < len(s) {
        out[at + i] = s[i];
        i = i + 1;
    }
    return at + len(s);
}

pub fn put_byte[&o](out: &!o [byte], at: int, b: int) -> [] int {
    if at < 0 || at >= len(out) {
        return 0 - 1;
    }
    out[at] = byte_of(b);
    return at + 1;
}

// A non-negative decimal.
pub fn put_int[&o](out: &!o [byte], at: int, v: int) -> [] int {
    if v < 0 {
        return 0 - 1;
    }
    var scale = 1;
    while v / scale >= 10 {
        scale = scale * 10;
    }
    var rest = v;
    var k = at;
    while scale > 0 {
        k = put_byte(out, k, '0' + rest / scale % 10);
        rest = rest % scale;
        scale = scale / 10;
    }
    return k;
}

// A non-negative number in lowercase hexadecimal, with at least `min` digits (zero-padded on the left).
pub fn put_hex[&o](out: &!o [byte], at: int, v: int, min: int) -> [] int {
    if v < 0 {
        return 0 - 1;
    }
    var n = 1;
    var rest = v / 16;
    while rest > 0 {
        n = n + 1;
        rest = rest / 16;
    }
    var width = n;
    if min > width {
        width = min;
    }
    var k = at;
    var i = width - 1;
    while i >= 0 {
        var d = 0;
        if i < n {
            var shifted = v;
            var j = 0;
            while j < i {
                shifted = shifted / 16;
                j = j + 1;
            }
            d = shifted % 16;
        }
        var c = '0' + d;
        if d >= 10 {
            c = 'a' + d - 10;
        }
        k = put_byte(out, k, c);
        i = i - 1;
    }
    return k;
}

// A JSON string's contents (no quotes), the first `max_in` bytes of `s` and at most `max_out` bytes of output, never stopping in the
// middle of an escape: `"` and `\` are backslash-escaped, every byte below 0x20, 0x7f and every byte from 0x80 up is written as
// `\u00XX` (the byte read as Latin-1: always valid JSON, never invalid UTF-8). Answers the new offset, or `0 - 1` if `out` is too
// small, and how many bytes of `s` it used.
pub fn put_json[&o, &s](out: &!o [byte], at: int, s: &s [byte], max_in: int, max_out: int) -> [] (int, int) {
    var k = at;
    var used = 0;
    var written = 0;
    var limit = len(s);
    if max_in < limit {
        limit = max_in;
    }
    while used < limit {
        let c = int_of(s[used]);
        var width = 1;
        if c == '"' || c == '\\' {
            width = 2;
        } else if c < 32 || c >= 127 {
            width = 6;
        }
        if written + width > max_out {
            return (k, used);
        }
        if width == 1 {
            k = put_byte(out, k, c);
        } else if width == 2 {
            k = put_byte(out, k, '\\');
            k = put_byte(out, k, c);
        } else {
            k = put(out, k, "\\u00");
            k = put_hex_digit(out, k, c / 16);
            k = put_hex_digit(out, k, c % 16);
        }
        written = written + width;
        used = used + 1;
    }
    return (k, used);
}

fn put_hex_digit[&o](out: &!o [byte], at: int, d: int) -> [] int {
    if d >= 10 {
        return put_byte(out, at, 'a' + d - 10);
    }
    return put_byte(out, at, '0' + d);
}

// The decimal digits `v` takes.
pub fn digits(v: int) -> [] int {
    var n = 1;
    var scale = 1;
    while v / scale >= 10 {
        scale = scale * 10;
        n = n + 1;
    }
    return n;
}

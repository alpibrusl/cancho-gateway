edition 5;

module gateway.proxy;

import std.bytes;
import std.conns;
import std.http;
import gateway.accesslog;
import gateway.admin;
import gateway.chunked;
import gateway.deploy;
import gateway.egress;
import gateway.forward;
import gateway.framing;
import gateway.metrics;
import gateway.out;
import gateway.problem;
import gateway.response;
import gateway.route;
import gateway.shared;
import gateway.adminloop;
import gateway.tlsio;
import gateway.websocket;

// The proxy core, first slice (task #5, docs/proxy.md): one thread, one poller, memory sized at start.
//
// A request is read, judged (`framing`), routed (`route`), checked against the compiled-in upstreams (`egress`), forwarded on a
// fresh upstream connection with `Connection: close` (`forward`; pooling is task #6), and the upstream's response is relayed
// to the client verbatim until the upstream closes. The client's connection closes after the response: no keep-alive on
// either side in this slice.
//
// Clients and upstream connections share one slot table, one buffer slab and one state slab; a slot is a client or an upstream
// connection, and the two ends of one request point at each other. Nothing is allocated after start.
//
// Per slot `k`, `state[24k..24k+24]` is:
//
//     0  1 if the slot is in use
//     1  kind: 1 client, 2 upstream in use, 3 upstream idle in the pool, 4 an admin connection (docs/observability.md section 7: phase 0 reading its
//        head, 1 waiting for the response buffer, 2 a short answer queued in `pends[k]`, 3 writing the metrics from `abuf`; 5 bytes left to write, 9 where
//        in `abuf` the next byte is, or before the buffer is taken which format was asked for; 7 its deadline, for the whole exchange)
//     2  the peer slot, or -1
//     3  phase. Client: 0 reading the head, 1 wants an upstream connection, 2 connecting, 3 streaming, 4 sending an error,
//                5 lingering after one (input read and discarded)
//                6 a WebSocket tunnel
//                Upstream: 0 connecting, 1 connected
//     4  bytes in `bufs[k]` read from this connection and not yet passed on
//     5  bytes in `pends[k]` waiting to be written to this connection
//     6  what the poller watches it for (1 read, 2 write, 0 neither)
//     7  deadline of the current phase in milliseconds, or 0
//     8  1 if the session ends once `pends[k]` has been written
//     9  client: request body bytes still to forward (a Content-Length), or -1 for a chunked body
//    10  client: 1 once the whole request body has been forwarded (or there is none)
//    11  client: the upstream index the route chose
//    12  client: deadline for the whole request, in milliseconds
//    13  client: 1 once any response byte has been queued for it
//    14  upstream: 1 once it has said goodbye; client: 1 once it has (no more reading)
//    15  client: the length of its request head in `bufs[k]`
//    16  client: 1 if its request has no body and is idempotent, so it may be sent again on a fresh connection; the head is then
//        kept in `bufs[k]` until the session ends.   upstream: 0 awaiting the response head, 1 relaying its body
//    17  client: 1 once it has been sent again.   upstream: how the body is framed (0 none, 1 Content-Length, 2 chunked, 3 until close)
//    18  client: 1 if the request was a HEAD.   upstream: body bytes still to come (Content-Length)
//    19  upstream: 1 if the connection may carry another request once this response is done
//    20  upstream: 1 if the connection came from the pool
//    21  client: the expiry of the half-open trial it holds (0: none)
//    22  upstream: 1 if the request it is answering was a HEAD
//    23  client: 2 * the connection's sequence number + 1 if its route trusts the forwarding headers (docs/headers.md)
//    24  client: the clock when it was accepted
//    25  client: the clock when its request was routed (0 until then)
//    26  client: the clock when the upstream's response head arrived (0 until then)
//    27  client: response bytes queued for it
//    28  client: request body bytes forwarded for it (as sent: chunk framing included)
//    29  client: the status it was sent (a refusal's, or the upstream's), 0 if none
//    30  client: flags, 1 the gateway refused it, 2 its response was relayed whole, 4 its access-log line is written
//    31  client: its route's index + 1, 0 if none was selected
//    32..39  client: TLS's (`gateway.tlsio`)
//    40  client: 0 not an upgrade, 1 a WebSocket upgrade asked for and not yet answered, 2 a tunnel (docs/websocket.md)
//    41  client: the route's subprotocols it offered, as a bitmask
//
// A tunnel is client phase 6 (bytes in `bufs[k]` are bound for the upstream) and upstream state 16 = 2 (bytes in `bufs[u]` are bound for the client): neither is framed any more.
//
// Per slot `k`, `meta[256k..256k+256]` is the client's: byte 0 the length of its request id, 1 of the rule tag it was refused with, 2 of its
// method, 3 of its path; then the id (64 bytes at 4), the tag (40 at 68), the method (16 at 108) and the path up to `?` (128 at 124).
// The id is the connection's own when it is accepted, and the client's if its route trusts one and it sent a valid one (docs/headers.md).
// The access-log line is built from these when the session ends (docs/observability.md).

// What `k` is watched for now: room to write if output is queued, input if the phase wants it.
fn settle[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int) -> [poll] int {
    let st = contents(core.state);
    let p = shared.stride() * k;
    if st[p] != 1 {
        return 0;
    }
    if st[p + 1] == 4 {
        adminloop.admin_settle(tab, core, k);
        return 0;
    }
    if st[p + 1] == 1 && st[p + tlsio.f_mode()] == tlsio.m_queued() {
        // Accepted and waiting its turn for a handshake: not watched, its ClientHello waits in the kernel.
        return 0;
    }
    var want = 0;
    if st[p + 5] > 0 || st[p + 1] == 1 && shared.tls_pending(core, k) {
        want = 2;
    }
    if st[p + 1] == 1 {
        // A client is read while its head or its body is arriving, or while it is lingering after a refusal; afterwards only a
        // hang-up matters, and the loop does not look for one (an HTTP client may half-close after its request).
        if st[p + 3] == 0 || st[p + 3] == 5 || st[p + 3] == 3 && st[p + 10] == 0 && st[p + 4] < shared.buf_size() && st[p + 14] == 0 || st[p + 3] == 6 && st[p + 4] < shared.buf_size() && st[p + 14] == 0 {
            want = want + 1;
        }
        if want % 2 == 1 && st[p + tlsio.f_cin()] > 0 && st[p + tlsio.f_mode()] != 0 {
            // Ciphertext is held that the engine has not yet taken: the socket has nothing to add, and watching it would spin.
            want = want - 1;
        }
    } else if st[p + 1] == 3 {
        // Idle in the pool: anything it says, or its closing, means it is no longer fit for use.
        want = 1;
    } else if st[p + 3] == 0 {
        want = 2;
    } else if st[p + 14] == 0 && st[p + 4] < shared.buf_size() {
        want = want + 1;
    }
    if want != st[p + 6] {
        conns.rewatch(tab, core.poller, k, shared.token_of(k), want);
        st[p + 6] = want;
    }
    return 0;
}

// Close slot `k`, whatever it is, and forget it.
fn close_slot[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int) -> [] int {
    conns.close(tab, k);
    contents(core.state)[shared.stride() * k] = 0;
    return 0;
}

// An idle connection to upstream `idx`, or -1.
fn pool_find[&c](core: &c shared.Core, idx: int) -> [] int {
    let st = contents(core.state);
    var k = 0;
    while k < shared.slot_limit() {
        if st[shared.stride() * k] == 1 && st[shared.stride() * k + 1] == 3 && st[shared.stride() * k + 11] == idx {
            return k;
        }
        k = k + 1;
    }
    return 0 - 1;
}

// Upstream `u` has finished a response and may carry another request: keep it, if the pool has room, else close it.
fn pool_return[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, u: int, now: int) -> [poll] int {
    let st = contents(core.state);
    let p = shared.stride() * u;
    if shared.pool_max() == 0 || shared.idle_count(core, st[p + 11]) >= shared.pool_max() {
        close_slot(tab, core, u);
        return 0;
    }
    st[p + 1] = 3;
    st[p + 2] = 0 - 1;
    st[p + 3] = 1;
    st[p + 4] = 0;
    st[p + 5] = 0;
    st[p + 7] = now + shared.idle_ms();
    st[p + 8] = 0;
    st[p + 14] = 0;
    st[p + 16] = 0;
    st[p + 17] = 0;
    st[p + 18] = 0;
    st[p + 19] = 0;
    st[p + 20] = 0;
    st[p + 22] = 0;
    settle(tab, core, u);
    return 0;
}

// The oldest idle connection is closed to make room. Answers 1 if there was one.
fn evict_idle[&t, &c](tab: &!t conns.Table, core: &!c shared.Core) -> [] int {
    let st = contents(core.state);
    var oldest = 0 - 1;
    var k = 0;
    while k < shared.slot_limit() {
        if st[shared.stride() * k] == 1 && st[shared.stride() * k + 1] == 3 && (oldest < 0 || st[shared.stride() * k + 7] < st[shared.stride() * oldest + 7]) {
            oldest = k;
        }
        k = k + 1;
    }
    if oldest < 0 {
        return 0;
    }
    close_slot(tab, core, oldest);
    return 1;
}

// May a request go to upstream `idx` now? 0: yes, the circuit is closed. 1: yes, as the single trial after the open period.
// 2: no, the circuit is open, or a trial is already in flight.
fn circuit_admit[&c](core: &!c shared.Core, idx: int, now: int) -> [] int {
    let h = contents(core.health);
    let b = 4 * idx;
    if shared.circuit_threshold() == 0 || h[b + 1] == 0 {
        return 0;
    }
    if now < h[b + 1] {
        return 2;
    }
    // Half open: one request at a time, and a trial that never reports back does not hold the circuit shut for ever.
    if h[b + 2] != 0 && now < h[b + 2] {
        return 2;
    }
    h[b + 2] = now + shared.connect_ms() + shared.upstream_ms();
    return 1;
}

// Upstream `idx` answered: the failures are forgotten and the circuit, if open, closes.
fn health_ok[&c](core: &!c shared.Core, idx: int) -> [] int {
    let h = contents(core.health);
    let b = 4 * idx;
    h[b] = 0;
    h[b + 1] = 0;
    h[b + 2] = 0;
    return 0;
}

// Upstream `idx` failed (it would not connect, did not answer in time, hung up without answering on a fresh connection, or said
// something unreadable). Enough in a row opens the circuit, and its idle pooled connections go. The count is not reset when the
// circuit opens, so a failed trial after the open period reopens it at once.
fn health_fail[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, idx: int, now: int) -> [] int {
    metrics.upstream_failed(contents(core.stats), idx);
    if shared.circuit_threshold() == 0 {
        return 0;
    }
    let h = contents(core.health);
    let st = contents(core.state);
    let b = 4 * idx;
    h[b] = h[b] + 1;
    if h[b] >= shared.circuit_threshold() {
        h[b + 1] = now + shared.circuit_open_ms();
        h[b + 2] = 0;
        var k = 0;
        while k < shared.slot_limit() {
            if st[shared.stride() * k] == 1 && st[shared.stride() * k + 1] == 3 && st[shared.stride() * k + 11] == idx {
                close_slot(tab, core, k);
            }
            k = k + 1;
        }
    }
    return 0;
}

// Upstream `u` has hung up, failed, or been written to in vain. If it was a pooled connection that died before saying anything and
// the request may be sent again (no body, idempotent) and has not been, it is sent again on a fresh connection; otherwise
// the client is answered 502, or, if the response was under way, simply closed.
fn upstream_lost[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, u: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let p = shared.stride() * u;
    let client = st[p + 2];
    if client < 0 || st[shared.stride() * client] != 1 {
        close_slot(tab, core, u);
        return 0;
    }
    let pc = shared.stride() * client;
    if st[p + 16] >= 1 {
        shared.drop_session(tab, core, client);
        return 0;
    }
    if st[p + 20] == 0 && st[p + 16] == 0 {
        // A fresh connection that hung up before answering: the upstream's failing, not a pooled connection going stale.
        health_fail(tab, core, st[p + 11], now);
    }
    if st[p + 4] == 0 && st[p + 20] == 1 && st[pc + 16] == 1 && st[pc + 17] == 0 {
        close_slot(tab, core, u);
        st[pc + 2] = 0 - 1;
        st[pc + 3] = 1;
        st[pc + 17] = 1;
        st[pc + 7] = now + shared.connect_ms();
        return 0;
    }
    refuse(tab, core, client, 502, "proxy.upstream-closed", now);
    return 0;
}

// Write what is queued for `k`, and, once nothing is left and `k` is to close, close it (a refusal first lingers). Answers 1 if
// the session ended or the upstream was replaced (the write failed, or `k` has closed).
fn flush[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let p = shared.stride() * k;
    let base = k * shared.pend_size();
    if st[p] != 1 {
        return 0;
    }
    if st[p + 5] == 0 && shared.tls_drain(tab, core, k) < 0 {
        shared.drop_session(tab, core, k);
        return 1;
    }
    if st[p + 5] > 0 {
        match shared.client_write(tab, core, k, pd[base..base + st[p + 5]]) {
            Sent::Wrote(n) => {
                copy_into(pd[base..base + st[p + 5] - n], pd[base + n..base + st[p + 5]]);
                st[p + 5] = st[p + 5] - n;
            }
            Sent::Again => {
            }
            Sent::Failed(e) => {
                if st[p + 1] == 2 {
                    upstream_lost(tab, core, k, now);
                } else {
                    shared.drop_session(tab, core, k);
                }
                return 1;
            }
        }
    }
    if st[p + 5] == 0 && st[p + 8] == 1 && !shared.tls_pending(core, k) {
        if st[p + 1] == 1 && st[p + 3] == 4 {
            // A final answer is out while the client may still be sending: linger, reading and discarding, until it stops or
            // the time is up.
            st[p + 3] = 5;
            st[p + 8] = 0;
            st[p + 7] = now + shared.linger_ms();
            // The lingering cap: the request's own total deadline, or three seconds, whichever comes first.
            if st[p + 12] == 0 || st[p + 12] > now + 3000 {
                st[p + 12] = now + 3000;
            }
            settle(tab, core, k);
            return 0;
        }
        shared.drop_session(tab, core, k);
        return 1;
    }
    return 0;
}

// Refuse the request of client `k` with `status` and `rule`: the upstream, if any, is closed, and a problem+json response is
// queued and the connection closed once it is sent (the poller reports the socket writable at once). If a response has already
// begun there is nothing honest to send: the session just ends.
fn refuse[&t, &c, &r](tab: &!t conns.Table, core: &!c shared.Core, k: int, status: int, rule: &r [byte], now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let pd = contents(core.pends);
    let p = shared.stride() * k;
    shared.release_trial(core, k);
    if st[p + 13] == 1 {
        shared.drop_session(tab, core, k);
        return 0;
    }
    let peer = st[p + 2];
    if peer >= 0 && st[shared.stride() * peer] == 1 {
        conns.close(tab, peer);
        st[shared.stride() * peer] = 0;
    }
    st[p + 2] = 0 - 1;
    // The record of the refusal, for the access log: its status and rule, and that the gateway made it.
    st[p + 29] = status;
    shared.flag_set(core, k, 1);
    shared.meta_put(core, k, 68, 40, 1, rule);
    let base = k * shared.pend_size();
    let n = problem.response(pd[base..base + shared.pend_size()], status, rule, shared.meta_get(core, k, 4, 0));
    if n < 0 {
        shared.drop_session(tab, core, k);
        return 0;
    }
    st[p + 5] = n;
    st[p + 27] = st[p + 27] + n;
    st[p + 8] = 1;
    st[p + 3] = 4;
    st[p + 4] = 0;
    st[p + 7] = now + shared.flush_ms();
    settle(tab, core, k);
    return 0;
}

// The upstream's response is complete: the client's connection ends once what is queued for it has been written, and the
// upstream goes back to the pool if it may carry another request (its framing allows it, nothing is left unread, the request's
// body was fully sent and the upstream did not hang up), else it is closed.
fn finish_response[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, u: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let pu = shared.stride() * u;
    let client = st[pu + 2];
    let pc = shared.stride() * client;
    let reuse = st[pu + 19] == 1 && st[pu + 4] == 0 && st[pc + 10] == 1 && st[pu + 14] == 0;
    st[pc + 2] = 0 - 1;
    st[pc + 8] = 1;
    shared.flag_set(core, client, 2);
    if st[pc + 10] == 0 {
        // The upstream answered before the request body was all sent: the client may still be sending, so it lingers.
        st[pc + 3] = 4;
    }
    if reuse {
        pool_return(tab, core, u, now);
    } else {
        close_slot(tab, core, u);
    }
    if flush(tab, core, client, now) == 0 {
        settle(tab, core, client);
    }
    return 0;
}

// Where client `k`'s accept value is in the meta area.
fn k_accept(k: int) -> [] int {
    return k * shared.meta_size() + shared.ws_accept_at();
}

// The upstream `u` answered an upgrade request with a `101` whose head is the first `r` bytes of its buffer (docs/websocket.md sections 6 and 7): check it against what
// the request called for; if it passes, tell the client, and from here both connections are a tunnel and nothing is framed.
fn upgrade_answered[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, u: int, r: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let tb = contents(core.table);
    let m = contents(core.meta);
    let pu = shared.stride() * u;
    let client = st[pu + 2];
    let pc = shared.stride() * client;
    let ub = u * shared.buf_size();
    let cb = client * shared.pend_size();
    let accept = k_accept(client);
    let view = bf[ub..ub + st[pu + 4]];
    let verdict = websocket.check_response(view[0..r], tb, m[accept..accept + 28], st[pc + shared.ws_mask()], route.subprotocols(st[pc + 31] - 1));
    if verdict < 0 {
        health_fail(tab, core, st[pu + 11], now);
        refuse(tab, core, client, websocket.status(0 - verdict), websocket.tag(0 - verdict), now);
        return 0;
    }
    health_ok(core, st[pu + 11]);
    let n = websocket.upgrade_response(view[0..r], tb, pd[cb + st[pc + 5]..cb + shared.pend_size()], shared.meta_get(core, client, 4, 0));
    if n < 0 {
        shared.drop_session(tab, core, client);
        return 0;
    }
    st[pc + 5] = st[pc + 5] + n;
    st[pc + 27] = st[pc + 27] + n;
    st[pc + 13] = 1;
    st[pc + 26] = now;
    st[pc + 29] = 101;
    // The tunnel's clocks replace the request's: idle (reset by every byte that moves) and lifetime (not).
    st[pc + 3] = 6;
    st[pc + 7] = now + deploy.ws_idle_ms();
    st[pc + 12] = now + deploy.ws_lifetime_ms();
    st[pc + shared.ws_mode()] = 2;
    st[pu + 16] = 2;
    copy_into(bf[ub..ub + st[pu + 4] - r], bf[ub + r..ub + st[pu + 4]]);
    st[pu + 4] = st[pu + 4] - r;
    metrics.ws_opened(contents(core.stats));
    return tunnel_down(tab, core, u, now);
}

// The tunnel, upstream to client: what the upstream `u` has said goes to its client's queue as far as there is room, and is written; when the upstream has closed and all it said
// has been passed on, the tunnel ends once the client has been sent it.
fn tunnel_down[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, u: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let pu = shared.stride() * u;
    let client = st[pu + 2];
    if client < 0 || st[shared.stride() * client] != 1 {
        close_slot(tab, core, u);
        return 0;
    }
    let pc = shared.stride() * client;
    let ub = u * shared.buf_size();
    let cb = client * shared.pend_size();
    var going = true;
    while going {
        going = false;
        var take = st[pu + 4];
        let room = shared.pend_size() - st[pc + 5];
        if take > room {
            take = room;
        }
        if take > 0 {
            copy_into(pd[cb + st[pc + 5]..cb + st[pc + 5] + take], bf[ub..ub + take]);
            copy_into(bf[ub..ub + st[pu + 4] - take], bf[ub + take..ub + st[pu + 4]]);
            st[pu + 4] = st[pu + 4] - take;
            st[pc + 5] = st[pc + 5] + take;
            st[pc + 27] = st[pc + 27] + take;
            st[pc + 7] = now + deploy.ws_idle_ms();
            let before = st[pc + 5];
            if flush(tab, core, client, now) == 1 {
                return 0;
            }
            going = st[pc + 5] < before && st[pu + 4] > 0;
        }
    }
    if st[pu + 14] == 1 && st[pu + 4] == 0 {
        st[pc + 8] = 1;
        if flush(tab, core, client, now) == 1 {
            return 0;
        }
    }
    settle(tab, core, client);
    settle(tab, core, u);
    return 0;
}

// The tunnel, client to upstream: what the client has sent goes to the upstream's queue as far as there is room, and is written; when the client has closed and all it sent has
// been written, the tunnel ends.
fn tunnel_up[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let p = shared.stride() * k;
    let u = st[p + 2];
    if u < 0 || st[shared.stride() * u] != 1 {
        shared.drop_session(tab, core, k);
        return 0;
    }
    let pu = shared.stride() * u;
    let cb = k * shared.buf_size();
    let ub = u * shared.pend_size();
    var moving = true;
    while moving {
        moving = false;
        var take = st[p + 4];
        let room = shared.pend_size() - st[pu + 5];
        if take > room {
            take = room;
        }
        if take > 0 {
            copy_into(pd[ub + st[pu + 5]..ub + st[pu + 5] + take], bf[cb..cb + take]);
            copy_into(bf[cb..cb + st[p + 4] - take], bf[cb + take..cb + st[p + 4]]);
            st[p + 4] = st[p + 4] - take;
            st[pu + 5] = st[pu + 5] + take;
            st[p + 28] = st[p + 28] + take;
            st[p + 7] = now + deploy.ws_idle_ms();
            let before = st[pu + 5];
            if flush(tab, core, u, now) == 1 {
                return 0;
            }
            moving = st[pu + 5] < before && st[p + 4] > 0;
        }
    }
    // Room has opened in the upstream's queue, or nothing was taken: write what is queued.
    if st[pu + 5] > 0 && flush(tab, core, u, now) == 1 {
        return 0;
    }
    if st[p + 14] == 1 && st[p + 4] == 0 && st[pu + 5] == 0 {
        shared.drop_session(tab, core, k);
        return 0;
    }
    settle(tab, core, k);
    settle(tab, core, u);
    return 0;
}

// Move what the upstream `u` has said to its client: first its head (parsed, rewritten, interim responses passed on), then its
// body as its framing says, as far as the client's queue has room.
fn pump_response[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, u: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let ch = contents(core.chunks);
    let tb = contents(core.table);
    let pu = shared.stride() * u;
    let client = st[pu + 2];
    if client < 0 || st[shared.stride() * client] != 1 {
        close_slot(tab, core, u);
        return 0;
    }
    let pc = shared.stride() * client;
    let ub = u * shared.buf_size();
    let cb = client * shared.pend_size();
    if st[pu + 16] == 2 {
        return tunnel_down(tab, core, u, now);
    }
    var going = true;
    while going {
        going = false;
        if st[pu + 16] == 0 {
            if st[pu + 4] > 0 {
                let view = bf[ub..ub + st[pu + 4]];
                var r = 0;
                if st[pc + shared.ws_mode()] == 1 {
                    r = response.parse_upgrade(view, tb);
                } else {
                    r = response.parse(view, tb);
                }
                if r < 0 {
                    health_fail(tab, core, st[pu + 11], now);
                    refuse(tab, core, client, response.status(0 - r), response.tag(0 - r), now);
                    return 0;
                }
                if r > 0 && response.code(tb) == 101 {
                    return upgrade_answered(tab, core, u, r, now);
                }
                if r > 0 && shared.pend_size() - st[pc + 5] >= r + 64 {
                    if response.interim(tb) {
                        // Passed on as it came; the final response is still to come.
                        copy_into(pd[cb + st[pc + 5]..cb + st[pc + 5] + r], view[0..r]);
                        st[pc + 5] = st[pc + 5] + r;
                        st[pc + 27] = st[pc + 27] + r;
                        st[pc + 13] = 1;
                    } else {
                        health_ok(core, st[pu + 11]);
                        let m = forward.rewrite_response(view[0..r], tb, pd[cb + st[pc + 5]..cb + shared.pend_size()], shared.meta_get(core, client, 4, 0));
                        if m < 0 {
                            shared.drop_session(tab, core, client);
                            return 0;
                        }
                        st[pc + 5] = st[pc + 5] + m;
                        st[pc + 27] = st[pc + 27] + m;
                        st[pc + 13] = 1;
                        st[pc + 26] = now;
                        st[pc + 29] = response.code(tb);
                        // The response has begun: only the total deadline remains.
                        st[pc + 7] = 0;
                        let mode = response.body_mode(tb, st[pu + 22] == 1);
                        st[pu + 17] = mode;
                        st[pu + 18] = response.content_length(tb);
                        st[pu + 19] = 0;
                        if response.reusable(tb, mode) {
                            st[pu + 19] = 1;
                        }
                        if mode == 2 {
                            chunked.init(ch[u * chunked.state_len()..u * chunked.state_len() + chunked.state_len()], 1099511627776);
                        }
                        st[pu + 16] = 1;
                    }
                    copy_into(bf[ub..ub + st[pu + 4] - r], bf[ub + r..ub + st[pu + 4]]);
                    st[pu + 4] = st[pu + 4] - r;
                    if st[pu + 16] == 1 && st[pu + 17] == 0 {
                        // A response with no body is complete with its head.
                        finish_response(tab, core, u, now);
                        return 0;
                    }
                    // Body bytes that came in the same read follow the head in the same write: one send instead of two.
                    if st[pu + 4] == 0 && flush(tab, core, client, now) == 1 {
                        return 0;
                    }
                    going = true;
                }
            }
        } else {
            var room = shared.pend_size() - st[pc + 5];
            var take = st[pu + 4];
            if take > room {
                take = room;
            }
            if take > 0 {
                var used = take;
                var done = false;
                let mode = st[pu + 17];
                if mode == 1 {
                    if used > st[pu + 18] {
                        used = st[pu + 18];
                    }
                    st[pu + 18] = st[pu + 18] - used;
                    done = st[pu + 18] == 0;
                } else if mode == 2 {
                    let slot_chunks = ch[u * chunked.state_len()..u * chunked.state_len() + chunked.state_len()];
                    let n = chunked.advance(bf[ub..ub + take], slot_chunks);
                    if n < 0 {
                        // A body that is not valid chunked framing: nothing honest to do but end the session.
                        shared.drop_session(tab, core, client);
                        return 0;
                    }
                    used = n;
                    done = chunked.is_done(slot_chunks);
                }
                copy_into(pd[cb + st[pc + 5]..cb + st[pc + 5] + used], bf[ub..ub + used]);
                copy_into(bf[ub..ub + st[pu + 4] - used], bf[ub + used..ub + st[pu + 4]]);
                st[pu + 4] = st[pu + 4] - used;
                st[pc + 5] = st[pc + 5] + used;
                st[pc + 27] = st[pc + 27] + used;
                let before = st[pc + 5];
                if done {
                    finish_response(tab, core, u, now);
                    return 0;
                }
                if flush(tab, core, client, now) == 1 {
                    return 0;
                }
                going = st[pc + 5] < before && st[pu + 4] > 0;
            }
        }
    }
    // The upstream has hung up and everything it said has been passed on.
    if st[pu + 14] == 1 && st[pu + 4] == 0 {
        if st[pu + 16] == 1 && st[pu + 17] == 3 {
            // A body that runs until the connection closes ends here.
            finish_response(tab, core, u, now);
        } else {
            upstream_lost(tab, core, u, now);
        }
        return 0;
    }
    settle(tab, core, client);
    settle(tab, core, u);
    return 0;
}

// Move request-body bytes from client `c`'s buffer to its upstream's queue, framed, and write them as far as there is room.
fn pump_request[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let ch = contents(core.chunks);
    let p = shared.stride() * k;
    let u = st[p + 2];
    if u < 0 || st[shared.stride() * u] != 1 || st[shared.stride() * u + 3] != 1 {
        return 0;
    }
    if st[p + 3] == 6 {
        return tunnel_up(tab, core, k, now);
    }
    let pu = shared.stride() * u;
    var moving = true;
    while moving {
        moving = false;
        if st[p + 10] == 0 && st[p + 4] > 0 {
            var room = shared.pend_size() - st[pu + 5];
            var take = st[p + 4];
            if take > room {
                take = room;
            }
            let cb = k * shared.buf_size();
            let ub = u * shared.pend_size();
            if take > 0 {
                var used = take;
                if st[p + 9] >= 0 {
                    if used > st[p + 9] {
                        used = st[p + 9];
                    }
                    st[p + 9] = st[p + 9] - used;
                    if st[p + 9] == 0 {
                        st[p + 10] = 1;
                    }
                } else {
                    let slot_chunks = ch[k * chunked.state_len()..k * chunked.state_len() + chunked.state_len()];
                    let n = chunked.advance(bf[cb..cb + take], slot_chunks);
                    if n < 0 {
                        refuse(tab, core, k, framing.status(0 - n), framing.tag(0 - n), now);
                        return 0;
                    }
                    used = n;
                    if chunked.is_done(slot_chunks) {
                        st[p + 10] = 1;
                    }
                }
                copy_into(pd[ub + st[pu + 5]..ub + st[pu + 5] + used], bf[cb..cb + used]);
                st[pu + 5] = st[pu + 5] + used;
                st[p + 28] = st[p + 28] + used;
                if st[p + 10] == 1 {
                    // Whatever follows the request is not this request's: the connection closes after the response.
                    st[p + 4] = 0;
                } else {
                    copy_into(bf[cb..cb + st[p + 4] - used], bf[cb + used..cb + st[p + 4]]);
                    st[p + 4] = st[p + 4] - used;
                }
                let before = st[pu + 5];
                if flush(tab, core, u, now) == 1 {
                    return 0;
                }
                moving = st[p + 10] == 0 && st[pu + 5] < before && st[p + 4] > 0;
            }
        }
    }
    // A request with no body to forward still has its head waiting.
    if st[pu + 5] > 0 && flush(tab, core, u, now) == 1 {
        return 0;
    }
    settle(tab, core, k);
    settle(tab, core, u);
    return 0;
}

// Client `k` has bytes while its head is arriving: judge them, route the request, and ask for an upstream connection.
fn head_ready[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let tb = contents(core.table);
    let ch = contents(core.chunks);
    let p = shared.stride() * k;
    let base = k * shared.buf_size();
    let view = bf[base..base + st[p + 4]];
    let r = framing.judge(view, tb);
    if r == 0 {
        settle(tab, core, k);
        return 0;
    }
    if r < 0 {
        refuse(tab, core, k, framing.status(0 - r), framing.tag(0 - r), now);
        return 0;
    }
    // The head is good: keep what the access log will say about it (the head's buffer is reused as the request goes on).
    shared.meta_put(core, k, 108, 16, 2, http.method(view, tb));
    shared.meta_put(core, k, 124, 128, 3, http.path(view, tb));
    let sel = route.select(http.header(view, tb, "host"), http.method(view, tb), http.path(view, tb));
    if sel < 0 {
        refuse(tab, core, k, route.status(0 - sel), route.tag(0 - sel), now);
        return 0;
    }
    // The route is known: the access log names it and its upstream even if the request is refused from here on.
    st[p + 31] = sel + 1;
    st[p + 11] = route.upstream(sel);
    if route.websocket(sel) == 1 && websocket.asks_upgrade(view, tb) {
        // A WebSocket upgrade (docs/websocket.md section 4): all of it is checked here, before anything else is decided about the request. It has no body (`ws.body`).
        let w = websocket.judge(view, tb, route.subprotocols(sel), route.origins(sel));
        if w < 0 {
            refuse(tab, core, k, websocket.status(0 - w), websocket.tag(0 - w), now);
            return 0;
        }
        if shared.tunnels(core, false) >= deploy.ws_max_tunnels() {
            refuse(tab, core, k, websocket.status(10), websocket.tag(10), now);
            return 0;
        }
        let m = contents(core.meta);
        let at = k_accept(k);
        websocket.accept_for(view, tb, m[at..at + 28]);
        st[p + shared.ws_mode()] = 1;
        st[p + shared.ws_mask()] = w;
    }
    let max_body = route.max_body(sel);
    if http.is_chunked(tb) {
        chunked.init(ch[k * chunked.state_len()..k * chunked.state_len() + chunked.state_len()], max_body);
        st[p + 9] = 0 - 1;
        st[p + 10] = 0;
    } else if http.content_length(tb) > max_body {
        refuse(tab, core, k, 413, "limit.body", now);
        return 0;
    } else if http.content_length(tb) > 0 {
        st[p + 9] = http.content_length(tb);
        st[p + 10] = 0;
    } else {
        st[p + 9] = 0;
        st[p + 10] = 1;
    }
    // Last of the checks the gateway makes itself: a request refused above never uses up the circuit's one trial.
    let admit = circuit_admit(core, route.upstream(sel), now);
    if admit == 2 {
        refuse(tab, core, k, 503, "proxy.circuit-open", now);
        return 0;
    }
    st[p + 21] = 0;
    if admit == 1 {
        st[p + 21] = contents(core.health)[4 * route.upstream(sel) + 2];
    }
    st[p + 11] = route.upstream(sel);
    st[p + 15] = r;
    // Whether its route trusts the forwarding headers, and so which id it carries: the client's own if the route believes one, else the
    // one it was given when it was accepted. Fixed here, so a retry carries the same one.
    st[p + 23] = st[p + 23] / 2 * 2 + route.trust_forwarded(sel);
    let own = forward.id_choice(view, tb, route.trust_forwarded(sel) == 1);
    if own >= 0 {
        shared.meta_put(core, k, 4, 64, 0, forward.id_value(view, tb, own));
    }
    st[p + 25] = now;
    // A request with no body and an idempotent method may be sent again, once, if a pooled connection turns out to be dead.
    let method = http.method(view, tb);
    st[p + 16] = 0;
    if st[p + 10] == 1 && (bytes.equal(method, "GET") || bytes.equal(method, "HEAD") || bytes.equal(method, "DELETE") || bytes.equal(method, "OPTIONS")) {
        st[p + 16] = 1;
    }
    st[p + 17] = 0;
    st[p + 18] = 0;
    if bytes.equal(method, "HEAD") {
        st[p + 18] = 1;
    }
    if st[p + shared.ws_mode()] == 1 {
        // An upgrade is never sent again and never takes a pooled connection (docs/websocket.md section 10).
        st[p + 16] = 0;
        st[p + 17] = 1;
    }
    st[p + 3] = 1;
    st[p + 7] = now + shared.connect_ms();
    settle(tab, core, k);
    return 0;
}

// Write the request head for client `k` into the queue of upstream slot `slot` (already in the table and initialised), and tie
// the two together. Answers 1 if that failed and the client was refused.
fn attach[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, slot: int, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let pd = contents(core.pends);
    let tb = contents(core.table);
    let p = shared.stride() * k;
    let q = shared.stride() * slot;
    // Rebuild the head's parse (another client may have used the table since) and rewrite it for the upstream.
    let kb = k * shared.buf_size();
    let view = bf[kb..kb + st[p + 15]];
    var failed = 0;
    if http.parse(view, tb) < 0 {
        failed = 1;
    } else {
        var m = 0;
        if st[p + shared.ws_mode()] == 1 {
            m = forward.rewrite_upgrade(view, tb, pd[slot * shared.pend_size()..slot * shared.pend_size() + shared.pend_size()], st[p + 23] % 2 == 1, st[p + tlsio.f_mode()] != 0, shared.meta_get(core, k, 4, 0));
        } else {
            m = forward.rewrite(view, tb, pd[slot * shared.pend_size()..slot * shared.pend_size() + shared.pend_size()], shared.pool_max() > 0, st[p + 23] % 2 == 1, st[p + tlsio.f_mode()] != 0, shared.meta_get(core, k, 4, 0));
        }
        if m < 0 {
            failed = 0 - m + 1;
        } else {
            st[q + 5] = m;
        }
    }
    if failed > 0 {
        close_slot(tab, core, slot);
        if failed == 1 {
            refuse(tab, core, k, 502, "proxy.head", now);
        } else {
            refuse(tab, core, k, forward.status(failed - 1), forward.tag(failed - 1), now);
        }
        return 1;
    }
    // The head is now the upstream's. What follows it in the client's buffer is request body, unless the request can be sent
    // again, in which case the head stays where it is until the session ends.
    if st[p + 16] != 1 {
        let hl = st[p + 15];
        copy_into(bf[kb..kb + st[p + 4] - hl], bf[kb + hl..kb + st[p + 4]]);
        st[p + 4] = st[p + 4] - hl;
        if st[p + 10] == 1 {
            st[p + 4] = 0;
        }
    }
    st[p + 2] = slot;
    return 0;
}

// Give client `k` an upstream connection, from the pool if there is an idle one (and this is not a second attempt), else a
// new one, and put the request head in its queue. Owns the table because `conns.put` does.
fn dial[&h, &n, &c](heap: &!h Heap, tab: conns.Table, net: &n Net(""), core: &!c shared.Core, k: int, now: int) -> [heap, conn_write, poll, net_out("")] conns.Table {
    var table = tab;
    let st = contents(core.state);
    let p = shared.stride() * k;
    let idx = st[p + 11];
    let addr = deploy.upstream_addr(idx);
    if !egress.allowed(addr) {
        borrow mut table as &!tw in {
            refuse(tw, core, k, 502, "proxy.egress", now);
        }
        return table;
    }
    var pooled = 0 - 1;
    if st[p + 17] == 0 {
        pooled = pool_find(core, idx);
    }
    if pooled >= 0 {
        let q = shared.stride() * pooled;
        st[q + 1] = 2;
        st[q + 2] = k;
        st[q + 3] = 1;
        st[q + 4] = 0;
        st[q + 5] = 0;
        st[q + 7] = 0;
        st[q + 8] = 0;
        st[q + 14] = 0;
        st[q + 16] = 0;
        st[q + 17] = 0;
        st[q + 18] = 0;
        st[q + 19] = 0;
        st[q + 20] = 1;
        st[q + 22] = st[p + 18];
        borrow mut table as &!tw in {
            if attach(tw, core, k, pooled, now) == 0 {
                st[p + 3] = 3;
                st[p + 7] = now + shared.upstream_ms();
                // pump_request writes the head and then settles both sessions, so the pooled connection's interest changes at most
                // once (and not at all when the write completes): settling first would arm and disarm write interest around it.
                pump_request(tw, core, k, now);
            }
        }
        return table;
    }
    let host = bytes.field(addr, ':', 1);
    let port_text = bytes.field(addr, ':', 2);
    var port = 0;
    var i = 0;
    while i < len(port_text) {
        port = port * 10 + int_of(port_text[i]) - '0';
        i = i + 1;
    }
    match tcp_connect_start(net, host, port) {
        Dialed::Ok(conn) => {
            let (grown, slot) = conns.put(heap, table, conn);
            table = grown;
            if slot < 0 || slot >= shared.slot_limit() {
                borrow mut table as &!tw in {
                    if slot >= 0 {
                        conns.close(tw, slot);
                    }
                    refuse(tw, core, k, 503, "limit.connections", now);
                }
                return table;
            }
            let q = shared.stride() * slot;
            st[q] = 1;
            st[q + 1] = 2;
            st[q + 2] = k;
            st[q + 3] = 0;
            st[q + 4] = 0;
            st[q + 5] = 0;
            st[q + 6] = 0;
            st[q + 7] = 0;
            st[q + 8] = 0;
            st[q + 11] = idx;
            st[q + 14] = 0;
            st[q + 16] = 0;
            st[q + 17] = 0;
            st[q + 18] = 0;
            st[q + 19] = 0;
            st[q + 20] = 0;
            st[q + 22] = st[p + 18];
            borrow mut table as &!tw in {
                let ignored = conns.nodelay(tw, slot);
                if attach(tw, core, k, slot, now) == 0 {
                    if conns.watch(tw, core.poller, slot, shared.token_of(slot), 2) != 0 {
                        close_slot(tw, core, slot);
                        refuse(tw, core, k, 502, "proxy.connect", now);
                    } else {
                        st[q + 6] = 2;
                        st[p + 3] = 2;
                        st[p + 7] = now + shared.connect_ms();
                        settle(tw, core, k);
                    }
                }
            }
        }
        Dialed::Failed(e) => {
            borrow mut table as &!tw in {
                health_fail(tw, core, idx, now);
                refuse(tw, core, k, 502, "proxy.connect", now);
            }
        }
    }
    return table;
}

fn read_client[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, now: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let p = shared.stride() * k;
    let base = k * shared.buf_size();
    let heard = shared.client_read(tab, core, k, bf[base + st[p + 4]..base + shared.buf_size()]);
    shared.tls_promote(core, k, now);
    match heard {
        Received::Data(got) => {
            st[p + 4] = st[p + 4] + got;
            if st[p + 3] == 0 {
                head_ready(tab, core, k, now);
            } else if st[p + 3] == 6 {
                tunnel_up(tab, core, k, now);
            } else {
                pump_request(tab, core, k, now);
            }
        }
        Received::End => {
            if st[p + 3] == 6 {
                // The client closed the tunnel: what it sent is forwarded, then both ends close (cancho has no half-close).
                st[p + 14] = 1;
                shared.flag_set(core, k, 2);
                tunnel_up(tab, core, k, now);
            } else if st[p + 3] == 0 || st[p + 10] == 0 {
                // It left before its request was whole.
                shared.drop_session(tab, core, k);
            } else {
                st[p + 14] = 1;
                settle(tab, core, k);
            }
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            shared.drop_session(tab, core, k);
        }
    }
    return 0;
}

fn read_upstream[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, u: int, now: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let bf = contents(core.bufs);
    let p = shared.stride() * u;
    let base = u * shared.buf_size();
    match conns.read(tab, u, bf[base + st[p + 4]..base + shared.buf_size()]) {
        Received::Data(got) => {
            st[p + 4] = st[p + 4] + got;
            pump_response(tab, core, u, now);
        }
        Received::End => {
            st[p + 14] = 1;
            if st[p + 16] == 2 && st[p + 2] >= 0 {
                // The upstream closed a tunnel: an ending by a peer, not by a failure (docs/websocket.md section 7).
                shared.flag_set(core, st[p + 2], 2);
            }
            pump_response(tab, core, u, now);
        }
        Received::Again => {
        }
        Received::Failed(e) => {
            st[p + 14] = 1;
            pump_response(tab, core, u, now);
        }
    }
    return 0;
}

// The poller said slot `k` is ready: readiness 1 is readable (or hung up), 2 is writable.
fn step[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, k: int, readiness: int, now: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    let p = shared.stride() * k;
    if st[p] != 1 {
        return 0;
    }
    if st[p + 1] == 4 {
        adminloop.admin_step(tab, core, k, readiness, now);
        return 0;
    }
    if st[p + 1] == 1 {
        if st[p + 3] == 4 {
            if readiness % 4 >= 2 {
                flush(tab, core, k, now);
            } else {
                shared.drop_session(tab, core, k);
            }
            return 0;
        }
        if st[p + 3] == 5 {
            // Lingering: read and discard until the client closes.
            let bf = contents(core.bufs);
            match shared.client_read(tab, core, k, bf[k * shared.buf_size()..k * shared.buf_size() + shared.buf_size()]) {
                Received::Data(got) => {
                    // Still sending: wait for it to stop, up to the lingering cap.
                    if now + shared.linger_ms() < st[p + 12] {
                        st[p + 7] = now + shared.linger_ms();
                    }
                }
                Received::End => {
                    shared.drop_session(tab, core, k);
                }
                Received::Again => {
                }
                Received::Failed(e) => {
                    shared.drop_session(tab, core, k);
                }
            }
            return 0;
        }
        if (st[p + 5] > 0 || st[p + tlsio.f_mode()] >= tlsio.m_handshake()) && readiness % 4 >= 2 {
            if flush(tab, core, k, now) == 1 {
                return 0;
            }
            // Room has opened for more of the response.
            let up = st[p + 2];
            if up >= 0 && st[shared.stride() * up] == 1 {
                pump_response(tab, core, up, now);
            }
            if st[p] != 1 {
                return 0;
            }
        }
        if readiness % 2 == 1 && (st[p + 3] == 0 || st[p + 3] == 3 && st[p + 10] == 0 || st[p + 3] == 6) {
            read_client(tab, core, k, now);
        }
        return 0;
    }
    if st[p + 1] == 3 {
        // Idle in the pool and heard from: it hung up, or spoke out of turn. Either way it is finished.
        close_slot(tab, core, k);
        return 0;
    }
    // An upstream connection.
    let client = st[p + 2];
    if client < 0 || st[shared.stride() * client] != 1 {
        shared.drop_session(tab, core, k);
        return 0;
    }
    if st[p + 3] == 0 {
        let outcome = conns.connect_status(tab, k);
        if outcome != 0 {
            health_fail(tab, core, st[p + 11], now);
            refuse(tab, core, client, 502, "proxy.connect", now);
            return 0;
        }
        st[p + 3] = 1;
        st[shared.stride() * client + 3] = 3;
        st[shared.stride() * client + 7] = now + shared.upstream_ms();
        pump_request(tab, core, client, now);
        return 0;
    }
    if st[p + 5] > 0 && readiness % 4 >= 2 {
        if flush(tab, core, k, now) == 1 {
            return 0;
        }
        pump_request(tab, core, client, now);
        if st[p] != 1 {
            return 0;
        }
    }
    if readiness % 2 == 1 && st[p + 14] == 0 {
        read_upstream(tab, core, k, now);
    }
    return 0;
}

// Deadlines: a client whose phase or whole request has run out of time is answered 408 or 504, or, if its response has
// begun, simply closed.
fn sweep[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, now: int) -> [conn_write, poll] int {
    let st = contents(core.state);
    var k = 0;
    while k < shared.slot_limit() {
        let p = shared.stride() * k;
        if st[p] == 1 && st[p + 1] == 3 && now >= st[p + 7] {
            close_slot(tab, core, k);
        }
        if st[p] == 1 && st[p + 1] == 4 && now >= st[p + 7] {
            if st[p + 3] == 1 {
                // Waited the whole exchange for the metrics buffer: say so, and give the answer a second to be written.
                st[p + 7] = now + 1000;
                adminloop.admin_error(tab, core, k, 503, "admin.busy", now);
            } else {
                shared.drop_session(tab, core, k);
            }
        }
        if st[p] == 1 && st[p + 1] == 1 && (st[p + tlsio.f_mode()] == tlsio.m_queued() || st[p + tlsio.f_mode()] == tlsio.m_handshake()) {
            // Before the handshake is done there is no HTTP to answer with: a client that is too slow is dropped, as the engine would drop it.
            if now >= st[p + 7] {
                shared.drop_session(tab, core, k);
            }
        } else if st[p] == 1 && st[p + 1] == 1 && st[p + 3] == 6 {
            // A tunnel: closed when it is older than `ws_max_lifetime_ms`, or nothing has moved for `ws_idle_timeout_ms` (docs/websocket.md section 7). No Close frame
            // is sent: the gateway does not parse frames, so it cannot know where one ends.
            if st[p + 12] != 0 && now >= st[p + 12] {
                shared.meta_put(core, k, 68, 40, 1, websocket.tag(websocket.lifetime_rule()));
                shared.drop_session(tab, core, k);
            } else if st[p + 7] != 0 && now >= st[p + 7] {
                shared.meta_put(core, k, 68, 40, 1, websocket.tag(websocket.idle_rule()));
                shared.drop_session(tab, core, k);
            }
        } else if st[p] == 1 && st[p + 1] == 1 {
            if st[p + 12] != 0 && now >= st[p + 12] {
                refuse(tab, core, k, 504, "timeout.total", now);
            } else if st[p + 7] != 0 && now >= st[p + 7] {
                if st[p + 3] == 0 {
                    refuse(tab, core, k, 408, "timeout.header", now);
                } else if st[p + 3] == 1 || st[p + 3] == 2 {
                    health_fail(tab, core, st[p + 11], now);
                    refuse(tab, core, k, 504, "timeout.connect", now);
                } else if st[p + 3] == 3 {
                    health_fail(tab, core, st[p + 11], now);
                    refuse(tab, core, k, 504, "timeout.upstream", now);
                } else {
                    shared.drop_session(tab, core, k);
                }
            }
        }
        k = k + 1;
    }
    return 0;
}

// Take every client waiting on the listener, up to the limit.
// `secure`: the listener is the TLS one, and its connections wait for a handshake before anything is read from them.
fn accept_all[&h, &l, &c](heap: &!h Heap, conn: conns.Table, listener: &!l Listener, core: &!c shared.Core, secure: bool, now: int) -> [heap, conn_accept, poll] conns.Table {
    let st = contents(core.state);
    var table = conn;
    var more = true;
    while more {
        match tcp_accept(listener) {
            Accepted::Ok(c) => {
                var held = 0;
                borrow table as &tt in {
                    held = conns.live(tt);
                }
                // A session holds two slots: leave room for the upstream half, closing an idle pooled connection if that is what it takes.
                if held + 2 > shared.slot_limit() {
                    var made = 0;
                    borrow mut table as &!et in {
                        made = evict_idle(et, core);
                    }
                    held = held - made;
                }
                if held + 2 > shared.slot_limit() {
                    conn_close(c);
                } else {
                    let (grown, slot) = conns.put(heap, table, c);
                    table = grown;
                    if slot >= shared.slot_limit() {
                        borrow mut table as &!ct in {
                            conns.close(ct, slot);
                        }
                    } else if slot >= 0 {
                        let p = shared.stride() * slot;
                        st[p] = 1;
                        st[p + 1] = 1;
                        st[p + 2] = 0 - 1;
                        st[p + 6] = 1;
                        st[p + 7] = now + shared.header_ms();
                        st[p + 12] = now + shared.total_ms();
                        var z = 3;
                        while z < 23 {
                            if z != 6 && z != 7 && z != 12 {
                                st[p + z] = 0;
                            }
                            z = z + 1;
                        }
                        if secure {
                            st[p + 6] = 0;
                            // Waiting for a handshake's turn is bounded by the whole request's time, not by the handshake's: a bound delays an honest peer.
                            st[p + 7] = now + shared.total_ms();
                            st[p + tlsio.f_since()] = now;
                            st[p + tlsio.f_mode()] = tlsio.m_queued();
                        }
                        shared.session_begin(core, slot, now);
                        borrow mut table as &!ct in {
                            // TCP_NODELAY: a request is forwarded in as many writes as it arrives in reads, and a small trailing write
                            // behind a large one would otherwise wait for the peer's delayed acknowledgement (tens of milliseconds).
                            // Best effort: a refusal leaves the connection working, only slower.
                            let ignored = conns.nodelay(ct, slot);
                            if conns.nonblocking(ct, slot) != 0 || !secure && conns.watch(ct, core.poller, slot, shared.token_of(slot), 1) != 0 {
                                conns.close(ct, slot);
                                st[p] = 0;
                                st[p + tlsio.f_mode()] = 0;
                            }
                        }
                    }
                }
            }
            Accepted::Again => {
                more = false;
            }
            Accepted::Failed(e) => {
                more = false;
            }
        }
    }
    return table;
}

// Start the queued handshakes the bounds allow, and read again the clients that may hold more than they have been given.
fn tls_turn[&t, &c](tab: &!t conns.Table, core: &!c shared.Core, now: int, now_unix: int) -> [conn_read, conn_write, poll] int {
    let st = contents(core.state);
    var go = true;
    while go {
        var started = 0 - 1;
        started = tlsio.admit(core.tls, st, shared.stride(), shared.slot_limit(), now, now_unix);
        if started >= 0 {
            st[shared.stride() * started + 7] = now + deploy.tls_handshake_ms();
            if conns.watch(tab, core.poller, started, shared.token_of(started), 1) != 0 {
                shared.drop_session(tab, core, started);
            } else {
                st[shared.stride() * started + 6] = 1;
            }
        } else if started <= 0 - 2 {
            shared.drop_session(tab, core, 0 - 2 - started);
        } else {
            go = false;
        }
    }
    var moved = 0;
    var queued = 0;
    var k = 0;
    while k < shared.slot_limit() {
        let p = shared.stride() * k;
        if st[p] == 1 && st[p + tlsio.f_mode()] == tlsio.m_queued() {
            queued = queued + 1;
        }
        if st[p] == 1 && st[p + 1] == 1 && st[p + tlsio.f_more()] == 1 && st[p + tlsio.f_mode()] >= tlsio.m_handshake() {
            if st[p + 3] == 0 || st[p + 3] == 3 && st[p + 10] == 0 && st[p + 4] < shared.buf_size() && st[p + 14] == 0 || st[p + 3] == 6 && st[p + 4] < shared.buf_size() && st[p + 14] == 0 {
                let before = st[p + tlsio.f_prog()];
                read_client(tab, core, k, now);
                settle(tab, core, k);
                if st[p] != 1 || st[p + tlsio.f_prog()] != before {
                    moved = moved + 1;
                }
            }
        }
        k = k + 1;
    }
    // Moved something: do not sleep; someone is waiting for a handshake's turn: wake in 20 ms to see if the bounds allow it now.
    return moved + 1000 * queued;
}

// Serve until the process is killed. Answers a non-zero status only if it could not start.
// `admin` is the admin listener's `tcp_listen` answer (`Listening::Failed` when the deployment has none): matched in place, so no second
// copy of the loop is needed for a gateway without one.
pub fn run[&h, &l, &a, &x, &n, &k, &i](heap: &!h Heap, listener: &!l Listener, admin: &!a Listening, secure: &!x Listening, tlsstate: tlsio.Tls, net: &n Net(""), clock: &k Clock, io: &!i Io) -> [heap, conn_accept, conn_read, conn_write, poll, clock, io_write, net_out("")] int {
    match poller_new() {
        Polling::Ok(pl) => {
            var poller = pl;
            borrow mut poller as &!pw in {
                poller_add_listener(pw, listener, 0);
                match admin {
                    Listening::Ok(al) => {
                        listener_nonblocking(al);
                        poller_add_listener(pw, al, shared.admin_token());
                    }
                    Listening::Failed(e) => {
                    }
                }
                match secure {
                    Listening::Ok(sl) => {
                        listener_nonblocking(sl);
                        poller_add_listener(pw, sl, shared.tls_token());
                    }
                    Listening::Failed(e) => {
                    }
                }
            }
            let limit = shared.slot_limit();
            var core = shared.Core { poller: poller, events: box_slice(heap, 128, 0), state: box_slice(heap, shared.stride() * limit, 0), bufs: box_slice(heap, limit * shared.buf_size(), byte_of(0)), pends: box_slice(heap, limit * shared.pend_size(), byte_of(0)), table: box_slice(heap, http.slots(64), 0), chunks: box_slice(heap, limit * chunked.state_len(), 0), health: box_slice(heap, 4 * 256, 0), ids: box_slice(heap, 16, 0), meta: box_slice(heap, limit * shared.meta_size(), byte_of(0)), logq: box_slice(heap, shared.logq_size(), byte_of(0)), stats: box_slice(heap, metrics.stats_len(), 0), rnames: box_slice(heap, metrics.names_len(), byte_of(0)), gauge: box_slice(heap, metrics.gauge_len(), 0), abuf: box_slice(heap, shared.admin_buffer_len(), byte_of(0)), tls: tlsstate };
            var tab = conns.empty(heap, 64);
            borrow mut core as &!cw in {
                let mono = clock_ms(clock);
                contents(cw.ids)[0] = mono;
                contents(cw.ids)[2] = clock_unix_ms(clock) - mono;
            }
            var running = true;
            var status = 0;
            var hurry = 0;
            while running {
                var ready = 0 - 1;
                // A TLS connection that moved bytes last turn may hold more that no socket event will announce: do not sleep.
                var nap = 250;
                if hurry % 1000 > 0 {
                    nap = 0;
                } else if hurry > 0 {
                    nap = 20;
                }
                borrow mut core as &!cw in {
                    ready = poller_wait(cw.poller, contents(cw.events), nap);
                }
                let now = clock_ms(clock);
                borrow mut core as &!cw in {
                    contents(cw.ids)[3] = now;
                }
                var j = 0;
                while j < ready {
                    var token = 0 - 1;
                    var readiness = 0;
                    borrow core as &cr in {
                        token = contents(cr.events)[2 * j];
                        readiness = contents(cr.events)[2 * j + 1];
                    }
                    if token == 0 {
                        borrow mut core as &!cw in {
                            tab = accept_all(heap, tab, listener, cw, false, now);
                        }
                    } else if token == shared.tls_token() {
                        match secure {
                            Listening::Ok(sl) => {
                                borrow mut core as &!cw in {
                                    tab = accept_all(heap, tab, sl, cw, true, now);
                                }
                            }
                            Listening::Failed(e) => {
                            }
                        }
                    } else if token == shared.admin_token() {
                        match admin {
                            Listening::Ok(al) => {
                                borrow mut core as &!cw in {
                                    tab = adminloop.accept_admin(heap, tab, al, cw, now);
                                }
                            }
                            Listening::Failed(e) => {
                            }
                        }
                    } else {
                        borrow mut tab as &!tw in {
                            borrow mut core as &!cw in {
                                step(tw, cw, token - 1, readiness, now);
                            }
                        }
                    }
                    j = j + 1;
                }
                borrow mut tab as &!tw in {
                    borrow mut core as &!cw in {
                        hurry = tls_turn(tw, cw, now, contents(cw.ids)[2] + now);
                    }
                }
                // Clients that asked for an upstream connection this turn.
                var k = 0;
                while k < limit {
                    var wants = false;
                    borrow core as &cr in {
                        let s = contents(cr.state);
                        wants = s[shared.stride() * k] == 1 && s[shared.stride() * k + 1] == 1 && s[shared.stride() * k + 3] == 1;
                    }
                    if wants {
                        borrow mut core as &!cw in {
                            tab = dial(heap, tab, net, cw, k, now);
                        }
                    }
                    k = k + 1;
                }
                borrow mut tab as &!tw in {
                    borrow mut core as &!cw in {
                        sweep(tw, cw, now);
                        adminloop.admin_pump(tw, cw, now);
                    }
                }
                // The lines of the requests that ended this turn, written together (docs/observability.md section 3).
                var pending = 0;
                borrow core as &cr in {
                    pending = contents(cr.ids)[4];
                }
                if pending > 0 {
                    var failed = false;
                    borrow mut core as &!cw in {
                        let wrote = write_bytes(io, contents(cw.logq)[0..pending]);
                        if wrote != pending {
                            failed = true;
                        }
                        match flush_out(io) {
                            Done::Ok(z) => {
                            }
                            Done::Failed(e) => {
                                failed = true;
                            }
                        }
                        contents(cw.ids)[4] = 0;
                        if failed {
                            contents(cw.ids)[7] = contents(cw.ids)[7] + 1;
                            contents(cw.ids)[9] = now;
                        }
                    }
                    if failed && deploy.log_failure_exit() == 1 {
                        running = false;
                        status = 6;
                    }
                }
            }
            conns.drop(heap, tab);
            let shared.Core { poller, events, state, bufs, pends, table, chunks, health, ids, meta, logq, stats, rnames, gauge, abuf, tls } = core;
            poller_close(poller);
            unbox_slice(heap, events);
            unbox_slice(heap, state);
            unbox_slice(heap, bufs);
            unbox_slice(heap, pends);
            unbox_slice(heap, table);
            unbox_slice(heap, chunks);
            unbox_slice(heap, health);
            unbox_slice(heap, ids);
            unbox_slice(heap, meta);
            unbox_slice(heap, logq);
            unbox_slice(heap, stats);
            unbox_slice(heap, rnames);
            unbox_slice(heap, gauge);
            unbox_slice(heap, abuf);
            tlsio.close(heap, tls);
            return status;
        }
        Polling::Failed(e) => {
            tlsio.close(heap, tlsstate);
            return 4;
        }
    }
}

edition 5;

module gateway.admin;

import std.bytes;

// What an admin request asks for (docs/observability.md section 7). Pure: it reads the head the caller has buffered (up to and including
// the blank line) and answers a code, so every refusal is a table row. The admin port serves four things and nothing else, with no body.

pub fn metrics_json() -> [] int {
    return 0;
}

pub fn metrics_prometheus() -> [] int {
    return 1;
}

pub fn healthz() -> [] int {
    return 2;
}

pub fn readyz() -> [] int {
    return 3;
}

// Refusals: each has a rule tag and a status.
pub fn bad_method() -> [] int {
    return 10;
}

pub fn bad_path() -> [] int {
    return 11;
}

pub fn has_body() -> [] int {
    return 12;
}

pub fn bad_version() -> [] int {
    return 13;
}

pub fn bad_request() -> [] int {
    return 14;
}

pub fn tag(code: int) -> [] &static [byte] {
    if code == 10 {
        return "admin.method";
    }
    if code == 11 {
        return "admin.path";
    }
    if code == 12 {
        return "admin.body";
    }
    if code == 13 {
        return "admin.version";
    }
    if code == 14 {
        return "admin.request";
    }
    return "";
}

pub fn status(code: int) -> [] int {
    if code == 10 {
        return 405;
    }
    if code == 11 {
        return 404;
    }
    if code == 13 {
        return 505;
    }
    return 400;
}

fn lower(c: int) -> [] int {
    if c >= 'A' && c <= 'Z' {
        return c + 32;
    }
    return c;
}

// Is `s` equal to the lowercase `want`, ignoring the case of `s`?
fn same_name[&s](s: &s [byte], want: &static [byte]) -> [] bool {
    if len(s) != len(want) {
        return false;
    }
    var i = 0;
    while i < len(s) {
        if lower(int_of(s[i])) != int_of(want[i]) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

// The offset of the first CR LF in `s` at or after `from`, or `0 - 1`.
fn crlf[&s](s: &s [byte], from: int) -> [] int {
    var i = from;
    while i + 1 < len(s) {
        if s[i] == byte_of(13) && s[i + 1] == byte_of(10) {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

fn find[&s](s: &s [byte], c: int, from: int, to: int) -> [] int {
    var i = from;
    while i < to {
        if int_of(s[i]) == c {
            return i;
        }
        i = i + 1;
    }
    return 0 - 1;
}

// Does any header line of `head` (after the request line) have the name `want`?
fn has_header[&h](head: &h [byte], first: int, want: &static [byte]) -> [] bool {
    var at = first;
    while at < len(head) {
        let end = crlf(head, at);
        if end < 0 || end == at {
            return false;
        }
        let colon = find(head, ':', at, end);
        if colon > at && same_name(head[at..colon], want) {
            return true;
        }
        at = end + 2;
    }
    return false;
}

// The code for the head `head` (request line and headers, ending at the blank line).
pub fn parse[&h](head: &h [byte]) -> [] int {
    let le = crlf(head, 0);
    if le < 0 {
        return bad_request();
    }
    let s1 = find(head, ' ', 0, le);
    if s1 < 0 {
        return bad_request();
    }
    let s2 = find(head, ' ', s1 + 1, le);
    if s2 < 0 {
        return bad_request();
    }
    if !bytes.equal(head[0..s1], "GET") {
        return bad_method();
    }
    let version = head[s2 + 1..le];
    if !bytes.equal(version, "HTTP/1.1") && !bytes.equal(version, "HTTP/1.0") {
        if len(version) >= 5 && bytes.equal(version[0..5], "HTTP/") {
            return bad_version();
        }
        return bad_request();
    }
    let target = head[s1 + 1..s2];
    if len(target) == 0 || target[0] != byte_of('/') {
        return bad_path();
    }
    let q = find(target, '?', 0, len(target));
    var path = target;
    var query = target[len(target)..len(target)];
    if q >= 0 {
        path = target[0..q];
        query = target[q + 1..len(target)];
    }
    var code = bad_path();
    if bytes.equal(path, "/metrics") {
        if len(query) == 0 || bytes.equal(query, "format=json") {
            code = metrics_json();
        } else if bytes.equal(query, "format=prometheus") {
            code = metrics_prometheus();
        } else {
            return bad_request();
        }
    } else if bytes.equal(path, "/healthz") {
        code = healthz();
    } else if bytes.equal(path, "/readyz") {
        code = readyz();
    } else {
        return bad_path();
    }
    if has_header(head, le + 2, "content-length") || has_header(head, le + 2, "transfer-encoding") {
        return has_body();
    }
    return code;
}

// The offset just past the blank line that ends the head in `s`, or `0 - 1` if there is none yet.
pub fn head_end[&s](s: &s [byte]) -> [] int {
    var i = 0;
    while i + 3 < len(s) {
        if s[i] == byte_of(13) && s[i + 1] == byte_of(10) && s[i + 2] == byte_of(13) && s[i + 3] == byte_of(10) {
            return i + 4;
        }
        i = i + 1;
    }
    return 0 - 1;
}

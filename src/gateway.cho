edition 6;

import std.io;
import gateway.deploy;
import gateway.proxy;
import gateway.shared;
import gateway.tlsio;
import gateway.version;

// `gateway` -- the reverse proxy (docs/design.md, docs/proxy.md). `gateway --version` prints its name and version; any other
// invocation serves on the port the deployment compiled in (`generated/deploy.cho`).

fn write_all[&r, &i](io: &!i Io, s: &r [byte]) -> [io_write] int {
    var n = 0;
    while n < len(s) {
        putchar(io, int_of(s[n]));
        n = n + 1;
    }
    return len(s);
}

// The admin listener's `tcp_listen` answer, or a `Failed` for a deployment that has none (`proxy.run` matches it as "no admin listener").
fn admin_listening[&n](net: &n Net("")) -> [net_in("")] Listening {
    if deploy.admin_port() == 0 {
        return Listening::Failed(0);
    }
    return tcp_listen(net, deploy.admin_port(), 16, 0);
}

// The TLS listener's `tcp_listen` answer, or a `Failed` for a deployment that has none.
fn tls_listening[&n](net: &n Net("")) -> [net_in("")] Listening {
    if deploy.tls_port() == 0 {
        return Listening::Failed(0);
    }
    return tcp_listen(net, deploy.tls_port(), 1024, 0);
}

fn main(world: World) -> [] int {
    let Split { io, ffi, fs, heap, args, net, clock, signals } = split(world);
    release(signals);
    release(ffi);
    var status = 0;
    var show_version = false;
    borrow args as &g in {
        show_version = arg_count(g) > 1;
    }
    release(args);
    if show_version {
        borrow mut io as &!i in {
            write_all(i, version.name());
            write_all(i, " ");
            write_all(i, version.number());
            write_all(i, "\n");
        }
        release(io);
        release(fs);
        release(heap);
        release(net);
        release(clock);
        return 0;
    }
    var served = 3;
    borrow net as &nn in {
        match tcp_listen(nn, deploy.listen_port(), 1024, 0) {
            Listening::Ok(l) => {
                var listener = l;
                // The admin listener, if the deployment has one (docs/observability.md section 7); else a `Failed` that `proxy.run` matches as "none".
                var admin = admin_listening(nn);
                var admin_failed = false;
                if deploy.admin_port() != 0 {
                    borrow mut admin as &!aw in {
                        match aw {
                            Listening::Ok(x) => {
                            }
                            Listening::Failed(e) => {
                                admin_failed = true;
                            }
                        }
                    }
                }
                var secure = tls_listening(nn);
                var secure_failed = false;
                if deploy.tls_port() != 0 {
                    borrow mut secure as &!sw in {
                        match sw {
                            Listening::Ok(x) => {
                            }
                            Listening::Failed(e) => {
                                secure_failed = true;
                            }
                        }
                    }
                }
                if admin_failed || secure_failed {
                    served = 2;
                    release(fs);
                } else {
                    borrow mut heap as &!h in {
                        borrow mut listener as &!lh in {
                            borrow mut admin as &!ah in {
                                borrow mut secure as &!sh in {
                                    listener_nonblocking(lh);
                                    borrow clock as &ck in {
                                        borrow mut io as &!ii in {
                                            // TLS, if the deployment has `tls_listen`: the certificates are read and the engine made here, before the first
                                            // connection is taken; a bad identity ends the process with its own status (docs/tls.md section 3).
                                            let (made, how) = tlsio.start(h, fs, ck, shared.slot_limit(), ii);
                                            if how != 0 {
                                                tlsio.close(h, made);
                                                served = how;
                                            } else {
                                                served = proxy.run(h, lh, ah, sh, made, nn, ck, ii);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                match admin {
                    Listening::Ok(al) => {
                        listener_close(al);
                    }
                    Listening::Failed(e) => {
                    }
                }
                match secure {
                    Listening::Ok(sl) => {
                        listener_close(sl);
                    }
                    Listening::Failed(e) => {
                    }
                }
                listener_close(listener);
            }
            Listening::Failed(e) => {
                served = 2;
                release(fs);
            }
        }
    }
    release(io);
    release(heap);
    release(net);
    release(clock);
    status = served;
    return status;
}

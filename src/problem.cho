edition 5;

module gateway.problem;

import std.bytes;
import gateway.out;

// A response the gateway makes itself (docs/design.md section 8): `application/problem+json` (RFC 9457) carrying the rule tag,
// so a client or an agent branches on `rule`, not on English. The connection is told to close: after a refusal the gateway does
// not keep it.
//
//     HTTP/1.1 404 Not Found
//     Content-Type: application/problem+json
//     Content-Length: 123
//     X-Request-Id: 19b3c2a1f00-1f90-0000002a
//     Connection: close
//
//     {"type":"about:blank","title":"Not Found","status":404,"rule":"route.none","request_id":"19b3c2a1f00-1f90-0000002a"}

pub fn reason(status: int) -> [] &static [byte] {
    if status == 400 {
        return "Bad Request";
    }
    if status == 401 {
        return "Unauthorized";
    }
    if status == 403 {
        return "Forbidden";
    }
    if status == 404 {
        return "Not Found";
    }
    if status == 405 {
        return "Method Not Allowed";
    }
    if status == 408 {
        return "Request Timeout";
    }
    if status == 413 {
        return "Content Too Large";
    }
    if status == 426 {
        return "Upgrade Required";
    }
    if status == 429 {
        return "Too Many Requests";
    }
    if status == 431 {
        return "Request Header Fields Too Large";
    }
    if status == 500 {
        return "Internal Server Error";
    }
    if status == 501 {
        return "Not Implemented";
    }
    if status == 502 {
        return "Bad Gateway";
    }
    if status == 503 {
        return "Service Unavailable";
    }
    if status == 504 {
        return "Gateway Timeout";
    }
    if status == 505 {
        return "HTTP Version Not Supported";
    }
    return "Error";
}

// The body alone, at `at`; answers the new offset. `id` is the request's id (docs/observability.md section 4): a member of the body so
// that a client or an agent can quote it.
pub fn body[&o, &t, &d](out: &!o [byte], at: int, status: int, rule: &t [byte], id: &d [byte]) -> [] int {
    var k = out.put(out, at, "{\"type\":\"about:blank\",\"title\":\"");
    k = out.put(out, k, reason(status));
    k = out.put(out, k, "\",\"status\":");
    k = out.put_int(out, k, status);
    k = out.put(out, k, ",\"rule\":\"");
    k = out.put(out, k, rule);
    k = out.put(out, k, "\",\"request_id\":\"");
    k = out.put(out, k, id);
    return out.put(out, k, "\"}");
}

// Head and body, from offset 0; answers the length, or `0 - 1` if `out` is too small. The head carries the id too.
pub fn response[&o, &t, &d](out: &!o [byte], status: int, rule: &t [byte], id: &d [byte]) -> [] int {
    return response_after(out, status, rule, id, 0);
}

// `response`, with `Retry-After: <retry>` (whole seconds, docs/ratelimit.md section 5) between `Content-Length` and the rest when `retry` is above 0.
pub fn response_after[&o, &t, &d](out: &!o [byte], status: int, rule: &t [byte], id: &d [byte], retry: int) -> [] int {
    return response_challenge(out, status, rule, id, retry, "");
}

// `response_after`, and for a 401 whose `challenge` is not empty a `WWW-Authenticate` header after `Retry-After` (docs/auth.md section 7.2): the challenge, and `, error="invalid_request"` for
// `auth.malformed` or `, error="invalid_token"` for `auth.invalid`. Any other status carries no challenge, whatever is passed.
pub fn response_challenge[&o, &t, &d, &c](out: &!o [byte], status: int, rule: &t [byte], id: &d [byte], retry: int, challenge: &c [byte]) -> [] int {
    // The body's length is known without writing it twice: everything but the variable parts is fixed.
    let fixed = len("{\"type\":\"about:blank\",\"title\":\"") + len("\",\"status\":") + len(",\"rule\":\"") + len("\",\"request_id\":\"") + len("\"}");
    let length = fixed + len(reason(status)) + out.digits(status) + len(rule) + len(id);
    var k = out.put(out, 0, "HTTP/1.1 ");
    k = out.put_int(out, k, status);
    k = out.put(out, k, " ");
    k = out.put(out, k, reason(status));
    k = out.put(out, k, "\r\nContent-Type: application/problem+json\r\nContent-Length: ");
    k = out.put_int(out, k, length);
    if retry > 0 {
        k = out.put(out, k, "\r\nRetry-After: ");
        k = out.put_int(out, k, retry);
    }
    if status == 401 && len(challenge) > 0 {
        k = out.put(out, k, "\r\nWWW-Authenticate: ");
        k = out.put(out, k, challenge);
        if bytes.equal(rule, "auth.malformed") {
            k = out.put(out, k, ", error=\"invalid_request\"");
        } else if bytes.equal(rule, "auth.invalid") {
            k = out.put(out, k, ", error=\"invalid_token\"");
        }
    }
    if status == 426 {
        // RFC 6455 4.4: the versions the server speaks (docs/websocket.md section 4, row 7).
        k = out.put(out, k, "\r\nSec-WebSocket-Version: 13");
    }
    k = out.put(out, k, "\r\nX-Request-Id: ");
    k = out.put(out, k, id);
    k = out.put(out, k, "\r\nConnection: close\r\n\r\n");
    return body(out, k, status, rule, id);
}

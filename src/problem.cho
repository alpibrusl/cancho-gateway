edition 5;

module gateway.problem;

import gateway.out;

// A response the gateway makes itself (docs/design.md section 8): `application/problem+json` (RFC 9457) carrying the rule tag,
// so a client or an agent branches on `rule`, not on English. The connection is told to close: after a refusal the gateway does
// not keep it.
//
//     HTTP/1.1 404 Not Found
//     Content-Type: application/problem+json
//     Content-Length: 123
//     X-Request-Id: 19b3c2a1f00-1f90-0000002a
//     Connection: close
//
//     {"type":"about:blank","title":"Not Found","status":404,"rule":"route.none","request_id":"19b3c2a1f00-1f90-0000002a"}

pub fn reason(status: int) -> [] &static [byte] {
    if status == 400 {
        return "Bad Request";
    }
    if status == 404 {
        return "Not Found";
    }
    if status == 405 {
        return "Method Not Allowed";
    }
    if status == 408 {
        return "Request Timeout";
    }
    if status == 413 {
        return "Content Too Large";
    }
    if status == 431 {
        return "Request Header Fields Too Large";
    }
    if status == 500 {
        return "Internal Server Error";
    }
    if status == 501 {
        return "Not Implemented";
    }
    if status == 502 {
        return "Bad Gateway";
    }
    if status == 503 {
        return "Service Unavailable";
    }
    if status == 504 {
        return "Gateway Timeout";
    }
    if status == 505 {
        return "HTTP Version Not Supported";
    }
    return "Error";
}

// The body alone, at `at`; answers the new offset. `id` is the request's id (docs/observability.md section 4): a member of the body so
// that a client or an agent can quote it.
pub fn body[&o, &t, &d](out: &!o [byte], at: int, status: int, rule: &t [byte], id: &d [byte]) -> [] int {
    var k = out.put(out, at, "{\"type\":\"about:blank\",\"title\":\"");
    k = out.put(out, k, reason(status));
    k = out.put(out, k, "\",\"status\":");
    k = out.put_int(out, k, status);
    k = out.put(out, k, ",\"rule\":\"");
    k = out.put(out, k, rule);
    k = out.put(out, k, "\",\"request_id\":\"");
    k = out.put(out, k, id);
    return out.put(out, k, "\"}");
}

// Head and body, from offset 0; answers the length, or `0 - 1` if `out` is too small. The head carries the id too.
pub fn response[&o, &t, &d](out: &!o [byte], status: int, rule: &t [byte], id: &d [byte]) -> [] int {
    // The body's length is known without writing it twice: everything but the variable parts is fixed.
    let fixed = len("{\"type\":\"about:blank\",\"title\":\"") + len("\",\"status\":") + len(",\"rule\":\"") + len("\",\"request_id\":\"") + len("\"}");
    let length = fixed + len(reason(status)) + out.digits(status) + len(rule) + len(id);
    var k = out.put(out, 0, "HTTP/1.1 ");
    k = out.put_int(out, k, status);
    k = out.put(out, k, " ");
    k = out.put(out, k, reason(status));
    k = out.put(out, k, "\r\nContent-Type: application/problem+json\r\nContent-Length: ");
    k = out.put_int(out, k, length);
    k = out.put(out, k, "\r\nX-Request-Id: ");
    k = out.put(out, k, id);
    k = out.put(out, k, "\r\nConnection: close\r\n\r\n");
    return body(out, k, status, rule, id);
}

}

pub fn b64_text(i: int) -> [] &static [byte] {
    if i == 0 {
        return "";
    }
    if i == 1 {
        return "_A";
    }
    if i == 2 {
        return "ZkU";
    }
    if i == 3 {
        return "Uzsb";
    }
    if i == 4 {
        return "D8K7JQ";
    }
    if i == 5 {
        return "d8umbFc";
    }
    if i == 6 {
        return "jv-YmTOw";
    }
    if i == 7 {
        return "PVBDALe4_g";
    }
    if i == 8 {
        return "5Kmo8GXk9VA";
    }
    if i == 9 {
        return "J7BBMTToVEss";
    }
    if i == 10 {
        return "tuZrM4uXsLmuKA";
    }
    if i == 11 {
        return "99QMfi7q4UjPDPE";

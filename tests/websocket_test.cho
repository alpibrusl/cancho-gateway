edition 5;

import std.bytes;
import std.http;
import std.test;
import gateway.b64;
import gateway.response;
import gateway.sha1;
import gateway.websocket;

// Generated by a script kept out of the repository and then edited by hand: the handshake of docs/websocket.md, case by case. `j` is `websocket.judge` over a
// request head (the bytes after it are the "early data" of rule 5), for a route that serves `protocols` and admits `origins`.

fn j(request: &static [byte], protocols: &static [byte], origins: &static [byte]) -> [] int {
    var verdict = 0 - 99;
    region a {
        let table = alloc_slice[a](http.slots(32), 0);
        if http.parse(request, table) > 0 {
            verdict = websocket.judge(request, table, protocols, origins);
        }
    }
    return verdict;
}

fn sha1_check[&d, &e](message: &static [byte], want: &static [byte], digest: &!d [byte], enc: &!e [byte]) -> [] int {
    sha1.digest(message, digest);
    let n = b64.encode(digest, enc);
    test.assert_eq(n, len(want));
    test.assert(bytes.equal(enc[0..n], want));
    return 0;
}

// `check_response` for a `101` answer, against the accept value of the RFC's example key, the offered mask `mask`, and the route's `protocols`.
fn c(response_head: &static [byte], mask: int, protocols: &static [byte]) -> [] int {
    var verdict = 0 - 99;
    region a {
        let table = alloc_slice[a](response.slots(32), 0);
        if response.parse_upgrade(response_head, table) > 0 {
            verdict = websocket.check_response(response_head, table, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo=", mask, protocols);
        }
    }
    return verdict;
}

fn test_the_accept_value_of_the_rfc_example_and_of_known_digests() -> [] int {
    region a {
        let out = alloc_slice[a](28, byte_of(0));
        test.assert_eq(websocket.accept_key("dGhlIHNhbXBsZSBub25jZQ==", out), 28);
        test.assert(bytes.equal(out, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="));
    }
    return 0;
}

fn test_the_accept_value_is_computed_from_the_request() -> [] int {
    region a {
        let table = alloc_slice[a](http.slots(32), 0);
        let out = alloc_slice[a](28, byte_of(0));
        let r = "GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n";
        test.assert(http.parse(r, table) > 0);
        test.assert_eq(websocket.accept_for(r, table, out), 28);
        test.assert(bytes.equal(out, "s3pPLMBiTxaQ9kYGzzhZRbK+xOo="));
        let none = "GET / HTTP/1.1\r\nHost: a\r\n\r\n";
        test.assert(http.parse(none, table) > 0);
        test.assert_eq(websocket.accept_for(none, table, out), 0 - 1);
    }
    return 0;
}

fn test_a_good_handshake_is_admitted_and_answers_the_offered_subprotocols() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6", ""), 1);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), 1);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp2.0.1, ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), 3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: foo, ocpp2.0.1\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), 2);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6, ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), 1);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n", "", ""), 0);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUPGRADE: WebSocket\r\nconnection: keep-alive, Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n", "", ""), 0);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nOrigin: https://b.example:8443\r\n\r\n", "", "http://a.example,https://b.example:8443"), 0);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n", "", "http://a.example"), 0);
    return 0;
}

fn test_rule_1_refuses_a_method_other_than_GET() -> [] int {
    test.assert_eq(j("POST /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -1);
    return 0;
}

fn test_rule_2_refuses_HTTP_1_0() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.0\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -2);
    return 0;
}

fn test_rule_3_refuses_an_Upgrade_that_is_not_exactly_websocket_once() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket, h2c\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: h2c\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket2\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: \r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: close\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade, close\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade, sec-websocket-key\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade, origin\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade,\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: keep-alive\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade, X-Secret\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nX-Secret: 1\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -3);
    return 0;
}

fn test_rule_4_refuses_a_body_or_a_header_that_says_there_is_one() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nContent-Length: 0\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -4);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nContent-Length: 5\r\n\r\nhello", "ocpp1.6,ocpp2.0.1", ""), -4);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nTransfer-Encoding: chunked\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -4);
    return 0;
}

fn test_rule_5_refuses_bytes_after_the_head() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\nabcd", "ocpp1.6,ocpp2.0.1", ""), -5);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\nx", "ocpp1.6,ocpp2.0.1", ""), -5);
    return 0;
}

fn test_rule_6_refuses_a_version_other_than_13() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 8\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -6);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13, 8\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -6);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -6);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -6);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 013\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -6);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: \r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -6);
    return 0;
}

fn test_rule_7_refuses_a_key_that_is_not_16_bytes_in_canonical_base64() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==A\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: !hlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZR==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ=A\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQA=\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25j ZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: AAAAAAAAAAAAAAAAAAAAAAAA\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -7);
    return 0;
}

fn test_rule_8_refuses_a_subprotocol_the_route_does_not_serve_or_a_list_that_is_not_one() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: mqtt\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6,,ocpp2.0.1\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nSec-WebSocket-Protocol: ocpp2.0.1\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: oc pp\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6,ocpp1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), 1);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: OCPP1.6\r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: \r\n\r\n", "ocpp1.6,ocpp2.0.1", ""), -8);
    return 0;
}

fn test_rule_9_admits_no_browser_origin_that_is_not_listed_and_any_request_without_one() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: https://evil.example\r\n\r\n", "ocpp1.6", ""), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: https://evil.example\r\n\r\n", "ocpp1.6", "https://good.example"), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: https://good.example\r\n\r\n", "ocpp1.6", "https://good.example"), 1);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: https://good.example\r\nOrigin: https://good.example\r\n\r\n", "ocpp1.6", "https://good.example"), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: null\r\n\r\n", "ocpp1.6", "https://good.example"), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: HTTPS://good.example\r\n\r\n", "ocpp1.6", "https://good.example"), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: https://good.example/\r\n\r\n", "ocpp1.6", "https://good.example"), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: https://good.example.evil\r\n\r\n", "ocpp1.6", "https://good.example"), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: \r\n\r\n", "ocpp1.6", "https://good.example"), -9);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\nOrigin: https://good.example\r\n\r\n", "ocpp1.6", "https://a.example,https://good.example"), 1);
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6", "https://good.example"), 1);
    return 0;
}

fn test_a_key_of_sixteen_zero_bytes_is_canonical() -> [] int {
    test.assert_eq(j("GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: AAAAAAAAAAAAAAAAAAAAAA==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", "ocpp1.6", ""), 1);
    return 0;
}

fn test_a_request_asks_for_an_upgrade_by_either_header() -> [] int {
    region a {
        let table = alloc_slice[a](http.slots(32), 0);
        let r = "GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n";
        test.assert(http.parse(r, table) > 0);
        test.assert(websocket.asks_upgrade(r, table) == true);
    }
    region a {
        let table = alloc_slice[a](http.slots(32), 0);
        let r = "GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nConnection: close\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n";
        test.assert(http.parse(r, table) > 0);
        test.assert(websocket.asks_upgrade(r, table) == false);
    }
    region a {
        let table = alloc_slice[a](http.slots(32), 0);
        let r = "GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nUpgrade: h2c\r\nConnection: close\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n";
        test.assert(http.parse(r, table) > 0);
        test.assert(websocket.asks_upgrade(r, table) == true);
    }
    region a {
        let table = alloc_slice[a](http.slots(32), 0);
        let r = "GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nConnection: keep-alive, upgrade\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n";
        test.assert(http.parse(r, table) > 0);
        test.assert(websocket.asks_upgrade(r, table) == true);
    }
    region a {
        let table = alloc_slice[a](http.slots(32), 0);
        let r = "GET /ocpp/CP1 HTTP/1.1\r\nHost: csms.example\r\nSec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n";
        test.assert(http.parse(r, table) > 0);
        test.assert(websocket.asks_upgrade(r, table) == false);
    }
    return 0;
}

fn test_a_checked_101_is_accepted() -> [] int {
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), 0);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp2.0.1\r\n\r\n", 3, "ocpp1.6,ocpp2.0.1"), 0);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n", 0, ""), 0);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nupgrade: WebSocket\r\nconnection: keep-alive, upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\nServer: x\r\nSet-Cookie: a=b\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), 0);
    return 0;
}

fn test_rule_11_refuses_a_101_that_is_not_a_websocket_upgrade_or_has_a_body_header() -> [] int {
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: h2c\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: close\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\nContent-Length: 0\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\nTransfer-Encoding: chunked\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -11);
    return 0;
}

fn test_rule_12_refuses_an_accept_value_that_is_not_exactly_the_one_called_for() -> [] int {
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOA=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pplmbitxaq9kygzzhzrbk+xoo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=A\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: 0000000000000000000000000000\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -12);
    return 0;
}

fn test_rule_13_refuses_a_subprotocol_that_was_not_offered_or_not_served() -> [] int {
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp2.0.1\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -13);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n", 3, "ocpp1.6,ocpp2.0.1"), -13);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 0, ""), -13);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -13);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6, ocpp2.0.1\r\n\r\n", 3, "ocpp1.6,ocpp2.0.1"), -13);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: mqtt\r\n\r\n", 3, "ocpp1.6,ocpp2.0.1"), -13);
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: OCPP1.6\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -13);
    return 0;
}

fn test_rule_14_refuses_an_extension_nobody_asked_for() -> [] int {
    test.assert_eq(c("HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\nSec-WebSocket-Extensions: permessage-deflate\r\n\r\n", 1, "ocpp1.6,ocpp2.0.1"), -14);
    return 0;
}

fn test_a_101_is_a_refusal_unless_the_request_asked_for_an_upgrade() -> [] int {
    region a {
        let table = alloc_slice[a](response.slots(32), 0);
        let head = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\n\r\n";
        test.assert_eq(response.parse(head, table), 0 - 3);
        test.assert_eq(response.parse_upgrade(head, table), len(head));
        test.assert_eq(response.code(table), 101);
        test.assert_eq(response.parse_upgrade("HTTP/1.1 100 Continue\r\n\r\n", table), 25);
        test.assert_eq(response.parse_upgrade("HTTP/1.1 102 Processing\r\n\r\n", table), 27);
    }
    return 0;
}

fn test_the_head_the_client_is_sent_carries_only_what_was_checked() -> [] int {
    region a {
        let table = alloc_slice[a](response.slots(32), 0);
        let buf = alloc_slice[a](512, byte_of(0));
        let head = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\nServer: evil\r\nSet-Cookie: a=b\r\nSec-WebSocket-Extensions-X: 1\r\n\r\n";
        test.assert_eq(response.parse_upgrade(head, table), len(head));
        let n = websocket.upgrade_response(head, table, buf, "id-1");
        let want = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nSec-WebSocket-Protocol: ocpp1.6\r\nVia: 1.1 cancho-gateway\r\nX-Request-Id: id-1\r\n\r\n";
        test.assert_eq(n, len(want));
        test.assert(bytes.equal(buf[0..n], want));
        let bare = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\n\r\n";
        test.assert_eq(response.parse_upgrade(bare, table), len(bare));
        let m = websocket.upgrade_response(bare, table, buf, "id-1");
        let want2 = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=\r\nVia: 1.1 cancho-gateway\r\nX-Request-Id: id-1\r\n\r\n";
        test.assert_eq(m, len(want2));
        test.assert(bytes.equal(buf[0..m], want2));
        let tiny = alloc_slice[a](40, byte_of(0));
        test.assert_eq(websocket.upgrade_response(head, table, tiny, "id-1"), 0 - 1);
    }
    return 0;
}

fn test_every_rule_has_a_tag_and_the_refusals_a_status() -> [] int {
    var r = 1;
    while r <= websocket.rule_count() {
        test.assert(len(websocket.tag(r)) > 3);
        if r != websocket.idle_rule() && r != websocket.lifetime_rule() {
            test.assert(websocket.status(r) >= 400);
        } else {
            test.assert_eq(websocket.status(r), 0);
        }
        r = r + 1;
    }
    test.assert_eq(websocket.status(6), 426);
    test.assert_eq(websocket.status(9), 403);
    test.assert_eq(websocket.status(10), 503);
    test.assert_eq(websocket.status(12), 502);
    test.assert_eq(len(websocket.tag(0)), 0);
    test.assert_eq(len(websocket.tag(websocket.rule_count() + 1)), 0);
    return 0;
}

fn test_sha1_of_the_empty_message_and_of_two_blocks_through_the_accept_encoding() -> [] int {
    region a {
        let digest = alloc_slice[a](20, byte_of(0));
        let enc = alloc_slice[a](28, byte_of(0));
        sha1_check("", "2jmj7l5rSw0yVb/vlWAYkK/YBwk=", digest, enc);
        sha1_check("abc", "qZk+NkcGgWq6PiVxeFDCbJzQ2J0=", digest, enc);
        sha1_check("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq", "hJg+RBw70m66rkqh+VEp5eVGcPE=", digest, enc);
    }
    return 0;
}

edition 5;

import std.bytes;
import std.test;
import gateway.out;
import gateway.problem;

fn test_put_int() -> [] int {
    region a {
        let buf = alloc_slice[a](32, byte_of(0));
        test.assert_eq(out.put_int(buf, 0, 0), 1);
        test.assert(bytes.equal(buf[0..1], "0"));
        test.assert_eq(out.put_int(buf, 0, 1048576), 7);
        test.assert(bytes.equal(buf[0..7], "1048576"));
        test.assert_eq(out.put_int(buf, 3, 99), 5);
        test.assert_eq(out.put_int(buf, 0, 0 - 1), 0 - 1);
    }
    return 0;
}

fn test_put_refuses_what_does_not_fit() -> [] int {
    region a {
        let buf = alloc_slice[a](4, byte_of(0));
        test.assert_eq(out.put(buf, 0, "abcd"), 4);
        test.assert_eq(out.put(buf, 1, "abcd"), 0 - 1);
        test.assert_eq(out.put(buf, 4, "a"), 0 - 1);
        test.assert_eq(out.put_int(buf, 2, 12345), 0 - 1);
    }
    return 0;
}

fn test_a_404_is_exactly_this() -> [] int {
    region a {
        let buf = alloc_slice[a](512, byte_of(0));
        let n = problem.response(buf, 404, "route.none", "1a-1f90-0000002a");
        let want = "HTTP/1.1 404 Not Found\r\nContent-Type: application/problem+json\r\nContent-Length: 107\r\nX-Request-Id: 1a-1f90-0000002a\r\nConnection: close\r\n\r\n{\"type\":\"about:blank\",\"title\":\"Not Found\",\"status\":404,\"rule\":\"route.none\",\"request_id\":\"1a-1f90-0000002a\"}";
        test.assert_eq(n, len(want));
        test.assert(bytes.equal(buf[0..n], want));
    }
    return 0;
}

// Content-Length is the body's real length for every status the gateway sends and a rule of any length.
fn test_content_length_is_the_body_length() -> [] int {
    region a {
        let buf = alloc_slice[a](512, byte_of(0));
        let scratch = alloc_slice[a](512, byte_of(0));
        var status = 400;
        while status <= 505 {
            let n = problem.response(buf, status, "framing.transfer-encoding-repeated", "1a-1f90-0000002a");
            test.assert(n > 0);
            let blank = bytes.find(buf[0..n], "\r\n\r\n");
            test.assert(blank > 0);
            let body_len = n - blank - 4;
            let m = out.put(scratch, 0, "Content-Length: ");
            let k = out.put_int(scratch, m, body_len);
            test.assert(bytes.find(buf[0..blank], scratch[0..k]) > 0);
            status = status + 1;
        }
    }
    return 0;
}

fn test_a_buffer_too_small_is_refused() -> [] int {
    region a {
        let buf = alloc_slice[a](40, byte_of(0));
        test.assert_eq(problem.response(buf, 404, "route.none", "i"), 0 - 1);
    }
    return 0;
}

fn test_a_429_names_when_to_come_back_and_no_other_response_does() -> [] int {
    region a {
        let buf = alloc_slice[a](512, byte_of(0));
        let n = problem.response_after(buf, 429, "limit.rate", "1a-1f90-0000002a", 7);
        let want = "HTTP/1.1 429 Too Many Requests\r\nContent-Type: application/problem+json\r\nContent-Length: 115\r\nRetry-After: 7\r\nX-Request-Id: 1a-1f90-0000002a\r\nConnection: close\r\n\r\n{\"type\":\"about:blank\",\"title\":\"Too Many Requests\",\"status\":429,\"rule\":\"limit.rate\",\"request_id\":\"1a-1f90-0000002a\"}";
        test.assert_eq(n, len(want));
        test.assert(bytes.equal(buf[0..n], want));
        // Without a wait, the bytes are those of `response`; a wait of 0 or less adds nothing.
        let plain = problem.response(buf, 429, "limit.rate", "1a-1f90-0000002a");
        test.assert(bytes.find(buf[0..plain], "Retry-After") < 0);
        test.assert_eq(problem.response_after(buf, 429, "limit.rate", "1a-1f90-0000002a", 0), plain);
        test.assert_eq(problem.response_after(buf, 429, "limit.rate", "1a-1f90-0000002a", 0 - 3), plain);
        test.assert_eq(problem.response_after(buf, 429, "limit.rate", "1a-1f90-0000002a", 3600), plain + len("\r\nRetry-After: 3600"));
    }
    return 0;
}

fn test_a_401_carries_the_routes_challenge_and_no_other_response_does() -> [] int {
    region a {
        let buf = alloc_slice[a](600, byte_of(0));
        let ch = "Bearer realm=\"cancho-gateway\"";
        let n = problem.response_challenge(buf, 401, "auth.missing", "1a-1f90-0000002a", 0, ch);
        let want = "HTTP/1.1 401 Unauthorized\r\nContent-Type: application/problem+json\r\nContent-Length: 112\r\nWWW-Authenticate: Bearer realm=\"cancho-gateway\"\r\nX-Request-Id: 1a-1f90-0000002a\r\nConnection: close\r\n\r\n{\"type\":\"about:blank\",\"title\":\"Unauthorized\",\"status\":401,\"rule\":\"auth.missing\",\"request_id\":\"1a-1f90-0000002a\"}";
        test.assert_eq(n, len(want));
        test.assert(bytes.equal(buf[0..n], want));
        // The kind of failure is an auth-param of the challenge (RFC 6750 3.1), except for a missing credential.
        let m = problem.response_challenge(buf, 401, "auth.malformed", "i", 0, ch);
        test.assert(bytes.find(buf[0..m], "WWW-Authenticate: Bearer realm=\"cancho-gateway\", error=\"invalid_request\"\r\nX-Request-Id: i\r\n") > 0);
        let k = problem.response_challenge(buf, 401, "auth.invalid", "i", 0, ch);
        test.assert(bytes.find(buf[0..k], "WWW-Authenticate: Bearer realm=\"cancho-gateway\", error=\"invalid_token\"\r\nX-Request-Id: i\r\n") > 0);
        // A route that reads another header says which.
        let h = problem.response_challenge(buf, 401, "auth.invalid", "i", 0, "ApiKey realm=\"cancho-gateway\", header=\"x-api-key\"");
        test.assert(bytes.find(buf[0..h], "WWW-Authenticate: ApiKey realm=\"cancho-gateway\", header=\"x-api-key\", error=\"invalid_token\"\r\n") > 0);
        // A 403 is not a challenge, and neither is anything else, whatever is passed; no challenge means the bytes of `response`.
        let f = problem.response_challenge(buf, 403, "auth.forbidden", "i", 0, ch);
        test.assert(bytes.find(buf[0..f], "WWW-Authenticate") < 0);
        test.assert(bytes.find(buf[0..f], "403 Forbidden") > 0);
        let r = problem.response_challenge(buf, 429, "limit.rate", "i", 7, ch);
        test.assert(bytes.find(buf[0..r], "WWW-Authenticate") < 0);
        let plain = problem.response(buf, 401, "auth.missing", "i");
        test.assert(bytes.find(buf[0..plain], "WWW-Authenticate") < 0);
        test.assert_eq(problem.response_challenge(buf, 401, "auth.missing", "i", 0, ""), plain);
        // A buffer one byte short is refused, not overrun.
        let tight = alloc_slice[a](n - 1, byte_of(0));
        test.assert_eq(problem.response_challenge(tight, 401, "auth.missing", "1a-1f90-0000002a", 0, ch), 0 - 1);
    }
    return 0;
}
